APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=chatservice
DB_USERNAME=chatservice
DB_PASSWORD=chatservice

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=chatservice
AWS_SECRET_ACCESS_KEY=chatservice123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=chatservice
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=chatservice-local
REVERB_APP_KEY=chatservice-local-key
REVERB_APP_SECRET=chatservice-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Chave usada exclusivamente pelos endpoints administrativos do chat service
# (ex.: registro de sistemas integrados). Distinta de qualquer token de
# sistema emitido/validado via JWKS. O valor abaixo é só para o ambiente
# local do Docker Compose — gere uma chave própria para qualquer outro
# ambiente, nunca reaproveite este valor.
CHAT_ADMIN_API_KEY=chatservice-local-admin-key

## --- Docker (local environment) ---
# Host port mappings for docker-compose.yml — override here if any of these
# conflict with something else already running on your machine. Postgres and
# MinIO credentials above (DB_*, AWS_*) are reused as-is by their containers.
APP_PORT=8000
FORWARD_MINIO_PORT=9002
FORWARD_MINIO_CONSOLE_PORT=9091
